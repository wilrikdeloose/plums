{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PLuMS",
  "version": "0.1.0",
  "identifier": "nl.fontys.plums",
  "build": {
    "beforeDevCommand": "npm run vite:desktop",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run build:desktop-frontend",
    "frontendDist": "../dist/desktop"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PLuMS",
        "width": 1200,
        "height": 800,
        "minWidth": 820,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
